<div id="top-ik-collaborators-container"
     data-url="{{ path('app_dashboard_top_ik_collaborators') }}">

    {% if topIkCollaborators is defined and topIkCollaborators|length > 0 %}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h4 class="mb-0 text-primary">
                        IK par collaborateur
                    </h4>
                    <small class="text-muted">
                        Classement par montant total d'indemnités kilométriques pour l'année {{ yearSelected }}
                    </small>
                </div>

                <span class="badge bg-primary">
                    {{ topIkTotalItems }} collaborateur{{ topIkTotalItems > 1 ? 's' : '' }}
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 70px;">#</th>
                                <th>Collaborateur</th>
                                <th class="text-end">Nombre de trajets</th>
                                <th class="text-end">Km</th>
                                <th class="text-end">Montant IK</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for row in topIkCollaborators %}
                                <tr>
                                    <td class="text-center fw-bold">
                                        {{ ((topIkCurrentPage - 1) * topIkLimit) + loop.index }}
                                    </td>

                                    <td>
                                        {% if row.collaborator %}
                                            {{ row.collaborator }}
                                        {% else %}
                                            Collaborateur #{{ row.userId }}
                                        {% endif %}
                                    </td>

                                    <td class="text-end">
                                        {{ row.totalTrips }}
                                    </td>

                                    <td class="text-end">
                                        {{ row.totalKm|number_format(0, ',', ' ') }} km
                                    </td>

                                    <td class="text-end fw-bold">
                                        {{ row.totalAmount|number_format(2, ',', ' ') }} €
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if topIkTotalPages > 1 %}
                <div class="card-footer bg-white">
                    <nav aria-label="Pagination IK collaborateurs">
                        <ul class="pagination justify-content-end mb-0">
                            <li class="page-item {% if topIkCurrentPage <= 1 %}disabled{% endif %}">
                                <a class="page-link js-top-ik-page"
                                   href="#"
                                   data-page="{{ topIkCurrentPage - 1 }}"
                                   data-year="{{ yearSelected }}">
                                    Précédent
                                </a>
                            </li>

                            {% for page in 1..topIkTotalPages %}
                                <li class="page-item {% if page == topIkCurrentPage %}active{% endif %}">
                                    <a class="page-link js-top-ik-page"
                                       href="#"
                                       data-page="{{ page }}"
                                       data-year="{{ yearSelected }}">
                                        {{ page }}
                                    </a>
                                </li>
                            {% endfor %}

                            <li class="page-item {% if topIkCurrentPage >= topIkTotalPages %}disabled{% endif %}">
                                <a class="page-link js-top-ik-page"
                                   href="#"
                                   data-page="{{ topIkCurrentPage + 1 }}"
                                   data-year="{{ yearSelected }}">
                                    Suivant
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-light border mb-0">
            Aucun IK trouvé pour l'année {{ yearSelected }}.
        </div>
    {% endif %}
</div>