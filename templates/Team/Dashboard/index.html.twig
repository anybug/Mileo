{% extends 'Team/advanced_layout.html.twig' %}

{% block page_title %}
    {% apply spaceless %}
        {{ dashboard.title|default('Welcome')|trans }}
    {% endapply %}
{% endblock %}

{% block main %}

    <div class="dashboard-content row m-1">
        <div class="mt-3 pb-3 col-12 border-bottom border-light">
            <h3 class="text-primary mb-3">{{ 'Statistiques'|trans }} par année</h3>
            <span>{{ "Afficher"|trans }}</span>
            {% if years is defined and years|length > 0 %}
                <form action="{{ ea_url() }}" method="GET" id="yearSelected" class="d-inline-flex">
                    <select class="form-control form-select mb-2 yearSelected d-inline-flex" name="yearSelected" style="width: 100px;">
                        {% for year in years %}
                            <option value="{{ year }}" {% if yearSelected == year %}selected="selected"{% endif %}>
                                {{ year }}
                            </option>
                        {% endfor %}
                    </select>

                    <input type="hidden" name="menuIndex" value="{{ app.request.get('menuIndex') }}">
                    <input type="hidden" name="submenuIndex" value="{{ app.request.get('submenuIndex') }}">
                </form>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const select = document.querySelector('.yearSelected');
                        const form = document.getElementById('yearSelected');

                        if (!select || !form) {
                            return;
                        }

                        select.addEventListener('change', () => form.submit());
                    });
                </script>

                <div class="row">
                    <div class="p-4 col-lg-6">
                        <div class="card mb-4 shadow-sm">
                            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <h5 class="mb-1 text-primary">
                                        <i class="fa-solid fa-route me-2"></i>
                                        {{ chartTripsByMonth.data.datasets[0].label }}
                                    </h5>
                                </div>
                            </div>

                            <div class="card-body">
                                {% if chartTripsByMonth is not null and chartTripsByMonth.data.datasets[0].data|length > 0 %}
                                    {{ render_chart(chartTripsByMonth) }}
                                {% else %}
                                    <p>{{ "Pas de trajets pour cette période"|trans }}</p>
                                {% endif %}
                            </div>
                        </div> 

                        <div class="card mb-4 shadow-sm">
                            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <h5 class="mb-1 text-primary">
                                        <i class="fa fa-road me-2"></i>
                                        {{ chartAmountByMonth.data.datasets[0].label }}
                                    </h5>
                                </div>
                            </div>

                            <div class="card-body">
                                {% if chartAmountByMonth is not null and chartAmountByMonth.data.datasets[0].data|length > 0 %}
                                    {{ render_chart(chartAmountByMonth) }}
                                {% else %}
                                    <p>{{ "Pas d'IK pour cette période"|trans }}</p>
                                {% endif %}    
                            </div>
                        </div> 

                    </div>

                    <div class="p-4 col-lg-6">

                        <div class="card mb-4 shadow-sm">
                            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <h5 class="mb-1 text-primary">
                                        <i class="fa-solid fa-map-location-dot me-2"></i>
                                        {{ topCollaboratorIndemnitiesChart.data.datasets[0].label }}
                                    </h5>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="data-chart mb-4">
                                    {% if topCollaboratorIndemnitiesChart is not null and topCollaboratorIndemnitiesChart.data.datasets[0].data|length > 0 %}
                                        {{ render_chart(topCollaboratorIndemnitiesChart) }}
                                    {% else %}
                                        <p>{{ "Pas d'IK pour cette période"|trans }}</p>
                                    {% endif %} 
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>

                {% if topIkByMemberChart is defined and topIkByMemberChart is not null %}
                    <section class="mt-4 mb-4">
                        <div class="card border-0 shadow-sm overflow-hidden">
                            <div class="card-header bg-body-tertiary border-bottom py-3 px-4">
                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                    <div>
                                        <h5 class="mb-1 text-primary">
                                            <i class="fa-solid fa-chart-pie me-2"></i>
                                            {{ 'Répartition des IK par collaborateur'|trans }}
                                        </h5>

                                        <p class="text-muted small mb-0">
                                            {{ 'Les cinq principaux collaborateurs sont détaillés ; les autres sont regroupés.'|trans }}
                                        </p>
                                    </div>

                                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal px-3 py-2">
                                        <i class="fa-solid fa-trophy me-1"></i>
                                        {{ 'Top 5 + autres'|trans }}
                                    </span>
                                </div>
                            </div>

                            <div class="card-body p-3 p-md-4">
                                <div class="row align-items-center g-4">
                                    <div class="col-12 col-xl-8">
                                        <div class="position-relative" style="height: 400px;">
                                            {{ render_chart(topIkByMemberChart, {
                                                class: 'w-100 h-100'
                                            }) }}
                                        </div>
                                    </div>

                                    <div class="col-12 col-xl-4">
                                        <div class="border rounded-3 bg-body-tertiary p-3">
                                            <strong class="d-block mb-2">
                                                <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                                                {{ 'Lecture du graphique'|trans }}
                                            </strong>

                                            <p class="small text-muted mb-0">
                                                {{ 'Chaque part représente le montant total des indemnités kilométriques. Le kilométrage cumulé est indiqué dans la légende.'|trans }}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endif %}

                <hr />
                
                <h3 class="text-primary mb-3">{{ 'Statistiques globales'|trans }}</h3>
                <div class="row">
                    <div class="p-4 col-lg-6">

                        <div class="card mb-4 shadow-sm">
                            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <h5 class="mb-1 text-primary">
                                        <i class="fa-solid fa-route me-2"></i>
                                        {{ chartTripsByYear.data.datasets[0].label }}
                                    </h5>
                                </div>
                            </div>

                            <div class="card-body">
                                {% if chartTripsByYear is not null and chartTripsByYear.data.datasets[0].data|length > 0 %}
                                    {{ render_chart(chartTripsByYear) }}
                                {% else %}
                                    <p>{{ "Pas de trajets pour cette période"|trans }}</p>
                                {% endif %}
                            </div>
                        </div> 
                    </div>
                    <div class="p-4 col-lg-6">
                        <div class="card mb-4 shadow-sm">
                            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                <div>
                                    <h5 class="mb-1 text-primary">
                                        <i class="fa fa-road me-2"></i>
                                        {{ chartAmountByYear.data.datasets[0].label }}
                                    </h5>
                                </div>
                            </div>

                            <div class="card-body">
                                {% if chartAmountByYear is not null and chartAmountByYear.data.datasets[0].data|length > 0 %}
                                    {{ render_chart(chartAmountByYear) }}
                                {% else %}
                                    <p>{{ "Pas d'IK pour cette période"|trans }}</p>
                                {% endif %}    
                            </div>
                        </div> 
                    </div>
                </div>
            {% else %}
                <p>Vous n'avez pas encore de trajets.</p>
            {% endif %}
        </div>
    </div>
<hr />
{{ parent() }}

{% endblock %}
