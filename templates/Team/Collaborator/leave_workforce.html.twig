{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    {{ 'Sortir le collaborateur de l’effectif'|trans }}
{% endblock %}

{% block main %}
    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">
                <i class="fa-solid fa-user-minus text-danger me-2"></i>

                {{ collaborator.firstName }}
                {{ collaborator.lastName }}
            </h5>

            <p class="text-muted">
                Après confirmation, le collaborateur ne pourra plus se
                connecter ni créer ou modifier de rapport d’IK.

                Son historique restera consultable.
            </p>

            {% if lastReportEndDate %}
                <div class="alert alert-warning">
                    Le dernier rapport d’IK se termine le

                    <strong>
                        {{ lastReportEndDate|date('d/m/Y') }}
                    </strong>.

                    La date de sortie doit obligatoirement être postérieure
                    à cette date.
                </div>
            {% else %}
                <div class="alert alert-info">
                    Ce collaborateur ne possède aucun rapport d’IK.
                </div>
            {% endif %}

            {{ form_start(form) }}

                <div class="mb-4">
                    {{ form_label(
                        form.exitDate,
                        null,
                        {
                            label_attr: {
                                class: 'form-label fw-semibold'
                            }
                        }
                    ) }}

                    {{ form_widget(
                        form.exitDate,
                        {
                            attr: {
                                class: 'form-control'
                            }
                        }
                    ) }}

                    {{ form_help(form.exitDate) }}

                    <div class="text-danger mt-1">
                        {{ form_errors(form.exitDate) }}
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    {{ form_widget(form.submit) }}

                    <a
                        href="{{ ea_url()
                            .setController(
                                'App\\Controller\\Team\\TeamUserCrudController'
                            )
                            .setAction('detail')
                            .setEntityId(collaborator.id)
                        }}"
                        class="btn btn-secondary"
                    >
                        {{ 'Annuler'|trans }}
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}