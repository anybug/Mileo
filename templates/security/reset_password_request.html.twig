{% extends 'Front/base-layout-applab.html.twig' %}


{% form_theme requestPassForm '@EasyAdmin/symfony-form-themes/bootstrap_5_layout.html.twig' %}


{% set pageTitle = "Réinitialisation de mot de passe Mileo"|trans %}
{% block title %}{{ pageTitle }}{% endblock %}


{% block body_id %}body_reset_request{% endblock %}


{% block page_content %}


      <!-- ============================================-->
      <!-- <section> begin ============================-->
      <section class="py-6">

        <div class="container-lg">
          <div class="row align-items-center">
            <h1 class="fw-bold fs-4 display-3 lh-sm mt-4">Réinitialisation de mot de passe Mileo</h1>

            <div class="col-md-5 text-center text-md-start">

                <p class="my-4 pe-xl-5">
                    Vous allez recevoir par email un lien sécurisé vous permettant de réinitialiser votre mot de passe Mileo.
                </p>
                
				<div class="auth-box">
                    
                     {{ form_start(requestPassForm) }}
                        {{ form_row(requestPassForm.email) }}
                        <a href="{{ path('security_login') }}" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">Envoyer</button>
                    {{ form_end(requestPassForm) }}
				    	
				</div>
			
            </div>

			<div class="col-md-7 order-md-0 text-center text-md-start mt-0">
   

				<div class="row align-items-center mt-4">
					<div class="col-lg-12 order-md-1 text-center text-md-start z-index-2 cta-image">
						<img class="img-fluid mb-4 mb-md-0" src="{{ asset('img/illustrations/cta-original.png') }}" width="850" alt="" />
					</div>
				</div>
            </div>

        </div>
        <!-- end of .container-->

      </section>
      <!-- <section> close ============================-->
      <!-- ============================================-->


{% endblock %}