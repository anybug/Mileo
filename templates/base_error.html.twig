{# templates/base_error.html.twig #}
<!DOCTYPE html>
<html lang="fr" data-turbo="false">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% set pageTitle %}
        {% block content_title %}Erreur{% endblock %}
    {% endset %}

    <title>{% block title %}{{ pageTitle|striptags|trim }} - Mileo{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="bg-body-tertiary">
    <div class="min-vh-100 d-flex">

        <aside class="d-none d-lg-flex flex-column bg-white border-end"
               style="width: 260px;">
            <div class="px-4 py-3 border-bottom">
                <a href="/" class="d-inline-block">
                    <img src="{{ asset('img/logo.png') }}"
                        alt="Mileo"
                        height="38">
                </a>
            </div>
        </aside>

        <main class="flex-grow-1 d-flex flex-column">
            <section class="flex-grow-1 d-flex align-items-center justify-content-center p-4 p-lg-5">
                <div class="w-100" style="max-width: 720px;">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="text-primary fs-3">
                                    <i class="fa-solid fa-map-location-dot"></i>
                                </div>

                                <div>
                                    <div class="text-muted small mb-1">
                                        Itinéraire indisponible
                                    </div>

                                    <h1 class="h4 mb-0">
                                        {{ pageTitle }}
                                    </h1>
                                </div>
                            </div>
                            <div class="border-top pt-4">
                                {% block main %}{% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

    </div>
</body>
</html>