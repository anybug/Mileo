{# templates/admin/_assistant_preview_content.html.twig #}
{% set unrecognizedCalendarTripsCount = unrecognizedCalendarTripsCount|default(0) %}
<div class="alert alert-info w-75 mt-3">
    <div>
        {% set previewTxt = 'à ajouter au' %}
        {% set previewPeriodLabel %}
            {% if action is defined and action == 'duplicate_report' and targetPeriod is defined and targetPeriod %}
                {{ ((targetPeriod ~ '-01')|date)|format_date(pattern='MMMM yyyy')|capitalize }}
                {% set previewTxt = 'à créer dans le' %}
            {% else %}
                {{ report.getPeriod() }}
            {% endif %}
        {% endset %}

        <strong>
            {{ "Prévisualisation des trajets"|trans }} {{ previewTxt|trans }} {{ "Rapport d'IK de"|trans }} {{ previewPeriodLabel }}
        </strong>

        <div class="d-inline-flex flex-wrap align-items-center gap-2 ms-2">
            <span class="badge rounded-pill bg-primary text-light">
        
                <i class="fa fa-plus me-1"></i>{{ previewTrips|length }}

                {% if previewTrips|length > 1 %}
                    {{ "trajets"|trans }}
                {% else %}
                    {{ "trajet"|trans }}
                {% endif %}
            </span>

            {% if action is defined
                and action == 'import_calendar'
                and unrecognizedCalendarTripsCount > 0
                and previewTrips|length == 0 
            %}
                <span class="badge rounded-pill bg-warning text-dark">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    {{ unrecognizedCalendarTripsCount }}

                    {% if unrecognizedCalendarTripsCount > 1 %}
                        {{ "événements non reconnus"|trans }}
                    {% else %}
                        {{ "événement non reconnu"|trans }}
                    {% endif %}
                </span>
            {% endif %}
        </div>
    </div>
    
</div>

<table class="table table-bordered w-75">
    <thead>
        <tr>
            <th class="d-none"></th>
            <th>Date</th>
            <th>Départ</th>
            <th>Arrivée</th>
            <th>Km</th>
            <th>Aller-retour</th>
            <th>Km total</th>
            <th class="d-none">Véhicule</th>
            <th>Montant</th>
            <th>Motif</th>
        </tr>
    </thead>

    {% set hasCalendarTrips = false %}
    {% for trip in previewTrips %}
        {% if trip.is_calendar|default(false) %}
            {% set hasCalendarTrips = true %}
        {% endif %}
    {% endfor %}
    <tbody>
        {% for trip in previewTrips %}
        {% set isCalendarTrip = trip.is_calendar|default(false) %}

        <tr
            class="report-line-row tm-trip-item"
            data-calendar="{{ isCalendarTrip ? '1' : '0' }}"
            data-vehicule="{{ trip.vehicule_id }}"
        >
            <td class="d-none">
                {{ trip.date }}

                <input type="hidden" class="report_lines_travel_date" value="{{ trip.date }}">
                <input type="hidden" class="report_lines_start" value="{{ trip.start|e('html_attr') }}">
                <input type="hidden" class="report_lines_end" value="{{ trip.end|e('html_attr') }}">
                <input type="hidden" class="report_lines_km" value="{{ trip.km|default(0) }}">
                <input type="hidden" class="report_lines_km_total" value="{{ trip.km_total|default(0) }}">
                <input type="hidden" class="report_lines_amount" value="{{ trip.amount|default(0) }}">
                <input type="hidden" class="report_lines_vehicule" value="{{ trip.vehicule_id }}">
                <input type="hidden" class="report_lines_comment" value="{{ trip.comment|e('html_attr') }}">

                <input
                    type="checkbox"
                    class="report_lines_is_return d-none"
                    {% if trip.is_return %}checked{% endif %}
                >
            </td>

            <td class="text-nowrap">
                {{ trip.date|date('l')|trans }} <br>
                {{ trip.date|date('d/m/Y') }}
            </td>

            <td class="d-none">{{ trip.start }}</td>
            <td class="d-none">{{ trip.end }}</td>

            <td class="js-preview-start">
                {% if isCalendarTrip %}
                    {{ trip.start }}
                {% else %}
                    {{ trip.formattedStart|raw }}
                {% endif %}
            </td>

            <td class="js-preview-end">
                {% if isCalendarTrip %}
                    {{ trip.end }}
                {% else %}
                    {{ trip.formattedEnd|raw }}
                {% endif %}
            </td>

            <td class="js-preview-km">
                {% if isCalendarTrip %}-{% else %}{{ trip.km }}{% endif %}
            </td>
            <td>{{ trip.is_return ? 'Oui' : 'Non' }}</td>
            <td class="js-preview-km-total">
                {% if isCalendarTrip %}-{% else %}{{ trip.km_total }}{% endif %}
            </td>

            <td class="d-none">{{ trip.vehicule_id }}</td>

            <td class="js-preview-amount text-nowrap">
                {% if isCalendarTrip %}En cours...{% else %}{{ trip.amount }} €{% endif %}
            </td>
            <td>{{ trip.comment }}</td>
        </tr>
        {% else %}
        <tr>
            <td colspan="9">Aucun trajet à prévisualiser.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% if action is defined
    and action == 'import_calendar'
    and unrecognizedCalendarTripsCount > 0
    and previewTrips|length == 0
%}
    <div class="alert alert-warning w-75 mt-2">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>

        {% if unrecognizedCalendarTripsCount > 1 %}
            {{ unrecognizedCalendarTripsCount }}
            {{ "événements ont été trouvés dans votre calendrier mais n’ont pas été reconnus comme trajets."|trans }}
        {% else %}
            {{ "1 événement a été trouvé dans votre calendrier mais n’a pas été reconnu comme trajet."|trans }}
        {% endif %}
    </div>
{% endif %}
<div id="calculation-warning" class="alert alert-warning w-75 mt-2 d-none">
    <strong>Certains trajets ne se sont pas calculés automatiquement.</strong><br>
    Les lignes affichées en orange correspondent aux trajets pour lesquels Mileo n’a pas pu déterminer la distance ou le montant.
    Vous ne pouvez pas confirmer la création tant que ces trajets ne sont pas corrigés.
    Corrigez directement les adresses dans votre calendrier, puis relancez la prévisualisation.
</div>

{% if previewTrips|length > 0 %}
{# Formulaire de confirmation #}
<form method="POST" action="{{ confirmActionUrl }}">
    {# Champ caché pour les données des trajets #}
    <input type="hidden" name="trips"  id="assistant-trips-json" value="{{ previewTrips|json_encode|e('html_attr') }}">

    {% if action == 'duplicate_report' %}
        <input type="hidden" name="target_period" value="{{ targetPeriod }}">
        <input type="hidden" name="copy_mode" value="{{ copyMode|default('week_for_week') }}">
    {% endif %}

    {# Boutons de confirmation/annulation #}
    <div class="mt-3">
        <button type="submit" 
                class="btn btn-success js-confirm-dup {% if isCalendarTrip %}opacity-50{% endif %}" 
                {% if isCalendarTrip %}disabled{% endif %}
        >
            <i class="fa fa-check"></i> {{"Confirmer la création des trajets"|trans }}
        </button>
        <a href="{{ backUrl }}" class="btn btn-danger">
            <i class="fa fa-times"></i> {{"Annuler"|trans }}
        </a>
    </div>
</form>
{% endif %}

<script>
  (function () {
    const btn = document.querySelector('.js-confirm-dup');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
      if (btn.dataset.submitted === '1') {
        e.preventDefault();
        return;
      }
      btn.dataset.submitted = '1';
      btn.disabled = true;
    }, { once: true });
  })();
</script>

