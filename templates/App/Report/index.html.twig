{# DO THIS: the '!' symbol tells Symfony to extend from the original template #}
{% extends '@!EasyAdmin/crud/index.html.twig' %}

{% block filters %}

    {% if ea.request.query.all['filters'] is defined %}
        {% set applied_filters = ea.request.query.all['filters']|default([])|keys %}

        <style>
            .history-limited-option {
                color: #adb5bd !important;
                background-color: #f8f9fa !important;
            }

            optgroup[label="Accès payant"] {
                color: #6c757d;
                font-weight: 600;
            }
        </style>

        <script>
            function groupReportHistoryOptions(root, limitYear) {
                const select = root.querySelector('#filters_Period_value');

                if (!select || !limitYear) {
                    return;
                }

                if (select.tomselect) {
                    select.tomselect.destroy();
                }

                const options = Array.from(select.querySelectorAll('option'))
                    .map((option) => {
                        const source = `${option.textContent || ''} ${option.value || ''}`;
                        const match = source.match(/\b((?:19|20)\d{2})\b/);

                        if (!match) {
                            return null;
                        }

                        const year = parseInt(match[1], 10);

                        return {
                            year: year,
                            value: option.value,
                            label: option.textContent.trim(),
                            selected: option.selected,
                        };
                    })
                    .filter(Boolean)
                    .sort((a, b) => b.year - a.year);

                const availableOptions = options.filter((item) => item.year >= limitYear);
                const paidOptions = options.filter((item) => item.year < limitYear);

                select.innerHTML = '';

                if (availableOptions.length > 0) {
                    const availableGroup = document.createElement('optgroup');
                    availableGroup.label = '{{ "Historique disponible"|trans|e('js') }}';

                    availableOptions.forEach((item) => {
                        const option = document.createElement('option');

                        option.value = item.value;
                        option.textContent = item.label;
                        option.selected = item.selected;

                        availableGroup.appendChild(option);
                    });

                    select.appendChild(availableGroup);
                }

                if (paidOptions.length > 0) {
                    const paidGroup = document.createElement('optgroup');
                    paidGroup.label = '{{ "Accès payant"|trans|e('js') }}';

                    paidOptions.forEach((item) => {
                        const option = document.createElement('option');

                        option.value = item.value;
                        option.textContent = item.label;
                        option.disabled = true;
                        option.setAttribute('disabled', 'disabled');
                        option.classList.add('history-limited-option');

                        paidGroup.appendChild(option);
                    });

                    select.appendChild(paidGroup);
                }
            }

            fetch('{{ ea_url().setAction('renderFilters').includeReferrer()|raw }}', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.text())
            .then(data => {
                const ajaxFilters = document.querySelector('.ajaxFilters');

                if (!ajaxFilters) {
                    return;
                }

                ajaxFilters.innerHTML = data;

               {% if isFreeHistoryLimitedUser|default(false) and freeHistoryLimitYear is defined %}
                    setTimeout(() => {
                        groupReportHistoryOptions(
                            ajaxFilters,
                            {{ freeHistoryLimitYear }}
                        );
                    }, 300);
                {% endif %}
            })
            .catch(error => {
                console.error('Erreur lors du chargement des filtres :', error);
            });
        </script>

        <div class="ajaxFilters action-filters"></div>
    {% endif %}
{% endblock filters %}

{% block table_footer %}
    {% if num_results > 0 %}
        {% set applied_filters_Period = ea.request.query.all()['filters']['Period'] %}
        {% set foo = applied_filters_Period.value|split(' ') %}
        
        <tr class="bg-secondary text-primary">
            <th colspan="2" class="text-primary">{{ 'Total'|trans }} {{ 'year'|trans }} {% for item in foo %}{{ item|trans }} {% endfor %}</th>
            {#<th colspan="2" class="text-primary">{{ 'Total'|trans }} {{ 'year'|trans }} {{ applied_filters_Period.value }}</th>#}
            <th>{{ totals.km }} km</th>
            <th>{{ totals.amount|number_format(2, ',', ' ') }} {{ 'EUR'|currency_symbol }}</th>
            {% set pdfUrl = ea_url()
                .setAction('generatePdfPerYear') %}
            <th><a class="btn btn-primary float-end" href="{{ pdfUrl|raw }}"><i class="fa fa-download"></i> {{ 'Télécharger rapport annuel'|trans }} {% for item in foo %}{{ item|trans }} {% endfor %}</a></th>
        </tr>
    {% endif %}
    {% for vt in vehiculesTotals %}

        {% set form_change_scale_action = ea_url()
            .setAction('scaleChangeForYear')
            .set('vrid', vt.Vr.id)
            .includeReferrer()
        %}

    <tr class="bg-light text-secondary">
        <td colspan="2">
            {{ vt.Vehicule }}
            {% if vt.Vehicule.isElectric %}
                <span>(+ 20%)</span>
                <i class="fa fa-circle-info mx-2 text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="{{"Une majoration de 20% est appliquée pour les véhicules électriques"|trans}}"></i> 
            {% endif %}    
        </td>
        <td> 
            {{ vt.km }} km 
            {% if vt.warning is defined %}
                <i class="fa fa-exclamation-triangle mx-2 text-warning" data-bs-toggle="tooltip" data-bs-placement="top" title="{{vt.warning|trans}}"></i>           
            {% endif %}

            {% if vt.info is defined %}
                <i class="fa fa-circle-info mx-2 text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="{{vt.info|trans}}"></i>           
            {% endif %}
        </td>
        <td>
            {{ vt.amount|number_format(2, ',', ' ') }} {{ 'EUR'|currency_symbol }}
            
        </td>
        <td>{{ form(vt.form) }}</td>
    </tr>

    {% endfor %}
{% endblock %}

{% block paginator %}

{% endblock paginator %}
