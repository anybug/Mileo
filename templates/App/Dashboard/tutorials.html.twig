{% extends 'App/advanced_layout.html.twig' %}

{% block page_title %}
    {{ 'Tutoriels'|trans }}
{% endblock %}

{% block main %}

    <div class="container-fluid py-3">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h2 class="mb-1">
                    <i class="fa-solid fa-graduation-cap me-2 text-primary"></i>
                    Tutoriels
                </h2>

                <p class="text-muted mb-0">
                    Retrouvez toutes les aides pour apprendre à utiliser Mileo.
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">

                    <div class="col-12 col-lg-7">
                        <div class="position-relative">

                            <i
                                class="fa-solid fa-magnifying-glass text-muted position-absolute top-50 start-0 translate-middle-y ms-3"
                            ></i>

                            <input
                                type="search"
                                id="tutorialSearch"
                                class="form-control ps-5"
                                placeholder="Rechercher un tutoriel..."
                                aria-label="Rechercher un tutoriel"
                            >

                        </div>
                    </div>

                    <div class="col-12 col-lg-5">
                        <select id="tutorialCategory" class="form-select">

                            <option value="">
                                Toutes les catégories
                            </option>

                            {% set categories = [] %}

                            {% for tutorial in tutorials %}
                                {% if tutorial.category not in categories %}
                                    {% set categories = categories|merge([tutorial.category]) %}
                                {% endif %}
                            {% endfor %}

                            {% for category in categories %}
                                <option value="{{ category|lower }}">
                                    {{ category }}
                                </option>
                            {% endfor %}

                        </select>
                    </div>

                </div>
            </div>
        </div>

        <div class="row g-4" id="tutorialList">

            {% for tutorial in tutorials %}

                <div
                    class="col-12 col-md-6 col-xl-4 tutorial-item"
                    data-title="{{ tutorial.title|lower }}"
                    data-description="{{ tutorial.description|lower }}"
                    data-category="{{ tutorial.category|lower }}"
                >

                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column p-4">

                            <div class="d-flex justify-content-between align-items-start mb-4">

                                <div
                                    class="d-flex align-items-center justify-content-center rounded bg-primary bg-opacity-10 text-primary"
                                    style="width: 52px; height: 52px;"
                                >
                                    <i class="{{ tutorial.icon }} fs-4"></i>
                                </div>

                                <span class="badge bg-light text-secondary border">
                                    {{ tutorial.category }}
                                </span>

                            </div>

                            <h4 class="card-title mb-2">
                                {{ tutorial.title }}
                            </h4>

                            <p class="card-text text-muted mb-4">
                                {{ tutorial.description }}
                            </p>

                            <div class="mt-auto">

                                {% if tutorial.duration is defined %}
                                    <div class="text-muted small mb-3">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        {{ tutorial.duration }}
                                    </div>
                                {% endif %}

                                <a
                                    href="{{ path('app_tutorial_show', {
                                        slug: tutorial.slug
                                    }) }}"
                                    class="btn btn-primary w-100"
                                >
                                    Voir le tutoriel
                                    <i class="fa-solid fa-arrow-right ms-2"></i>
                                </a>

                            </div>

                        </div>
                    </div>

                </div>

            {% else %}

                <div class="col-12">
                    <div class="alert alert-info">
                        Aucun tutoriel n'est disponible pour le moment.
                    </div>
                </div>

            {% endfor %}

        </div>

        <div id="tutorialEmpty" class="text-center py-5 d-none">

            <div class="mb-3">
                <i class="fa-solid fa-magnifying-glass fs-1 text-muted"></i>
            </div>

            <h4>Aucun tutoriel trouvé</h4>

            <p class="text-muted">
                Essayez de modifier votre recherche ou votre catégorie.
            </p>

        </div>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const searchInput = document.getElementById('tutorialSearch');
            const categorySelect = document.getElementById('tutorialCategory');
            const tutorials = document.querySelectorAll('.tutorial-item');
            const emptyState = document.getElementById('tutorialEmpty');

            function filterTutorials() {

                const search = searchInput.value.toLowerCase().trim();
                const category = categorySelect.value.toLowerCase();

                let visibleCount = 0;

                tutorials.forEach(function (tutorial) {

                    const title = tutorial.dataset.title || '';
                    const description = tutorial.dataset.description || '';
                    const tutorialCategory = tutorial.dataset.category || '';

                    const matchesSearch =
                        search === ''
                        || title.includes(search)
                        || description.includes(search);

                    const matchesCategory =
                        category === ''
                        || tutorialCategory === category;

                    const visible = matchesSearch && matchesCategory;

                    tutorial.classList.toggle('d-none', !visible);

                    if (visible) {
                        visibleCount++;
                    }
                });

                emptyState.classList.toggle(
                    'd-none',
                    visibleCount !== 0
                );
            }

            searchInput.addEventListener('input', filterTutorials);
            categorySelect.addEventListener('change', filterTutorials);

        });
    </script>

{% endblock %}