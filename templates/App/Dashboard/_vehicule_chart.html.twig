{% if vehiculeChart is not null and vehiculePagination is not null %}
    {% set vehicleCount = vehiculePagination.totalVehicles %}
    {% set currentVehicleCount = vehiculeChart.data.labels|length %}
    {% set chartHeight = max(300, currentVehicleCount * 72) %}
    {% set currentPage = vehiculePagination.page %}
    {% set totalPages = vehiculePagination.totalPages %}

    <section class="mt-2 mb-4">
        {% if vehiculeChart is not null and vehiculePagination is not null %}
            {% set vehicleCount = vehiculePagination.totalVehicles %}
            {% set currentVehicleCount = vehiculeChart.data.labels|length %}
            {% set chartHeight = max(300, currentVehicleCount * 72) %}
            {% set currentPage = vehiculePagination.page %}
            {% set totalPages = vehiculePagination.totalPages %}

            <section class="mt-2 mb-4">
                <div class="card border-0 shadow-sm overflow-hidden">
                    <div class="card-header bg-body-tertiary border-bottom py-3 px-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <h5 class="mb-1 text-primary">
                                    <i class="fa-solid fa-car me-2"></i>
                                    {{ 'Indemnités par véhicule'|trans }}
                                </h5>

                                <p class="text-muted small mb-0">
                                    {{ 'Montant IK annuel et nombre de trajets pour chaque véhicule.'|trans }}
                                </p>
                            </div>

                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal px-3 py-2">
                                <i class="fa-solid fa-car-side me-1"></i>

                                {{ vehicleCount }}

                                {{ vehicleCount > 1
                                    ? 'véhicules'|trans
                                    : 'véhicule'|trans
                                }}
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-3 p-md-4">
                        <div
                            class="position-relative mb-3"
                            style="height: {{ chartHeight }}px;"
                        >
                            {{ render_chart(vehiculeChart, {
                                class: 'w-100 h-100'
                            }) }}
                        </div>

                        {% if totalPages > 1 %}
                            <nav
                                class="mb-3"
                                aria-label="{{ 'Pagination des véhicules'|trans }}"
                            >
                                <ul class="pagination pagination-sm justify-content-center align-items-center mb-0">
                                    <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                                        <button
                                            type="button"
                                            class="page-link"
                                            data-action="click->vehicule-pagination#changePage"
                                            data-page="{{ currentPage - 1 }}"
                                            {% if currentPage <= 1 %}
                                                disabled
                                            {% endif %}
                                        >
                                            <i class="fa-solid fa-chevron-left me-1"></i>
                                            {{ 'Précédent'|trans }}
                                        </button>
                                    </li>

                                    {% for pageNumber in 1..totalPages %}
                                        <li class="page-item {{ pageNumber == currentPage ? 'active' : '' }}">
                                            <button
                                                type="button"
                                                class="page-link"
                                                data-action="click->vehicule-pagination#changePage"
                                                data-page="{{ pageNumber }}"
                                                {% if pageNumber == currentPage %}
                                                    disabled
                                                    aria-current="page"
                                                {% endif %}
                                            >
                                                {{ pageNumber }}
                                            </button>
                                        </li>
                                    {% endfor %}

                                    <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                                        <button
                                            type="button"
                                            class="page-link"
                                            data-action="click->vehicule-pagination#changePage"
                                            data-page="{{ currentPage + 1 }}"
                                            {% if currentPage >= totalPages %}
                                                disabled
                                            {% endif %}
                                        >
                                            {{ 'Suivant'|trans }}
                                            <i class="fa-solid fa-chevron-right ms-1"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>

                            <div class="text-center text-muted small mb-3">
                                {{ 'Page'|trans }}
                                {{ currentPage }}
                                {{ 'sur'|trans }}
                                {{ totalPages }}
                            </div>
                        {% endif %}

                        <div class="d-flex flex-wrap justify-content-center gap-3 small text-muted">
                            <span>
                                <i class="fa-solid fa-circle text-primary me-1"></i>
                                {{ 'La longueur indique le montant IK.'|trans }}
                            </span>

                            <span>
                                <i class="fa-solid fa-circle-info me-1"></i>
                                {{ 'Le nombre de trajets apparaît sous le nom du véhicule.'|trans }}
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        {% else %}
            <div class="alert alert-light border mb-4">
                {{ 'Aucune donnée de véhicule pour cette période.'|trans }}
            </div>
        {% endif %}
    </section>
{% endif %}