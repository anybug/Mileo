{% extends 'App/advanced_layout.html.twig' %}

{% block page_title %}
    {{ tutorial.title }}
{% endblock %}

{% block main %}

<div class="container-fluid py-3">

    <div class="mb-4">
        <a
            href="{{ path('app_tutorials') }}"
            class="btn btn-secondary"
        >
            <i class="fa-solid fa-arrow-left me-2"></i>
            Retour aux tutoriels
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">

                        <div
                            class="d-flex align-items-center justify-content-center rounded bg-primary bg-opacity-10 text-primary flex-shrink-0"
                            style="width: 64px; height: 64px;"
                        >
                            <i class="{{ tutorial.icon }} fs-2"></i>
                        </div>

                        <div class="flex-grow-1">

                            <div class="d-flex flex-wrap gap-2 mb-2">

                                <span class="badge bg-light text-secondary border">
                                    {{ tutorial.category }}
                                </span>

                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-regular fa-clock me-1"></i>
                                    {{ tutorial.duration }}
                                </span>

                            </div>

                            <h1 class="h2 mb-2">
                                {{ tutorial.title }}
                            </h1>

                            <p class="text-muted mb-0">
                                {{ tutorial.description }}
                            </p>

                        </div>

                    </div>

                </div>
            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body p-3 p-lg-4">

                    <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden">

                        <video
                            id="tutorialVideo"
                            controls
                            preload="metadata"
                            playsinline
                            class="w-100 h-100"
                        >
                            <source
                                src="{{ asset(tutorial.video) }}#t={{ tutorial.start }},{{ tutorial.end }}"
                                type="video/mp4"
                            >

                            Votre navigateur ne permet pas de lire cette vidéo.
                        </video>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const video = document.getElementById('tutorialVideo');

    if (!video) {
        return;
    }

    const startTime = Number({{ tutorial.start }});
    const endTime = Number({{ tutorial.end }});

    let initialized = false;

    function goToTutorialStart() {
        if (initialized) {
            return;
        }

        initialized = true;

        video.currentTime = startTime;
    }

    /*
     * readyState >= 1 signifie que les métadonnées
     * de la vidéo sont déjà disponibles.
     *
     * C'est important lorsque la vidéo vient du cache.
     */
    if (video.readyState >= 1) {
        goToTutorialStart();
    } else {
        video.addEventListener(
            'loadedmetadata',
            goToTutorialStart,
            { once: true }
        );
    }

    /*
     * Sécurité supplémentaire :
     * lorsque la vidéo est réellement prête à être lue,
     * on vérifie qu'on est bien dans le bon segment.
     */
    video.addEventListener('canplay', function () {

        if (
            video.currentTime < startTime
            || video.currentTime >= endTime
        ) {
            video.currentTime = startTime;
        }

    }, { once: true });

    /*
     * Si l'utilisateur clique sur lecture alors que
     * la vidéo est en dehors du mini tutoriel,
     * on revient au début du tutoriel.
     */
    video.addEventListener('play', function () {

        if (
            video.currentTime < startTime
            || video.currentTime >= endTime
        ) {
            video.currentTime = startTime;
        }

    });

    /*
     * Arrêt automatique à la fin du mini tutoriel.
     */
    video.addEventListener('timeupdate', function () {

        if (video.currentTime >= endTime) {
            video.pause();
            video.currentTime = startTime;
        }

    });

});
</script>

{% endblock %}