{% extends 'App/advanced_layout.html.twig' %}

{% set page_title = "Les tuto Mileo" %}

{% block page_title %} {{ page_title|trans }}{% endblock %}
{% block content_title %}{{ page_title|trans }} : {{ tutorial.title }}{% endblock %}

{% block main %}

<article class="content">
    <section class="">
        <p class="fs-6">
            <a href="{{ path('app_tutorials') }}" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Retour aux tutoriels
            </a>
        </p>   
    </section>

    <section class="content-body">
        <div class="card shadow-sm w-75">
            <div class="card-header">
                <div class="d-flex align-items-center justify-content-center rounded bg-primary bg-opacity-10 text-primary flex-shrink-0" style="width: 64px; height: 64px;">
                    <i class="{{ tutorial.icon }} fs-2"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <span class="badge bg-light text-secondary border">
                            {{ tutorial.category }}
                        </span>
                        <span class="badge bg-light text-secondary border">
                            <i class="fa-regular fa-clock me-1"></i>
                            {{ tutorial.duration }}
                        </span>
                    </div>
                    <h1 class="h2 mb-2">{{ tutorial.title }}</h1>
                    <p class="text-muted mb-0">{{ tutorial.description }}</p>
                </div>
            </div>

            <div class="card-body p-3 p-lg-4">
                <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden">
                    <video id="tutorialVideo" controls preload="auto" playsinline class="w-100 h-100">
                        <source src="{{ asset(tutorial.video) }}" type="video/mp4">
                        Votre navigateur ne permet pas de lire cette vidéo.
                    </video>
                </div>
            </div>
        </div>    
    </section>

</article>

{% endblock %}