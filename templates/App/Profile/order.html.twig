{% extends 'App/advanced_layout.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% set title = "Abonnement Pro : accès à toutes fonctionnalités pendant 12 mois"|trans %}

{% block content_title %}
    {{ title }}
{% endblock %}

{% block main %}
<div class="d-flex justify-content-center card-group mt-4">
  <div class="col-lg-4">
    <div class="card shadow-lg mb-4 pb-4">
      <div class="card-header border-bottom-0 pt-4 pb-4">
        <div class="d-flex justify-content-center">
          <h4 class="h1 fw-bold">Pro</h4>
        </div>
        <h5 class="fw-bold text-center">Gérez vos IK sans effort pendant 1 an pour</h5>
        {% set priceExcVat = plan.pricePerYear|number_format %}
        {% set priceIncVat = priceExcVat*1.2 %}
        <h6 class="h2 fw-bold text-center">{{ priceExcVat }}€ HT <span class="text-secondary fw-normal px-1">({{ priceIncVat }}€ TTC)</span></h6>
      </div>

      <div class="card-body mx-auto">
        <ul class="list-unstyled mb-4">
            <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Assistant intelligent de duplication de trajets</span></li>
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Assistant intelligent de duplication de rapports</span></li>
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Import de trajets depuis un calendrier connecté</span></li>
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Nombre de véhicules illimité</span></li>
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Adresses favorites illimitées</span></li>
          
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Participation aux décisions sur les innovations</span></li>
          <li class="text-700 py-2"><i class="fa-solid fa-circle-check text-success"></i> <span class="text-secondary"> Support 5/7j de 9h à 18h</span></li>
        </ul>
        <p>Activation immédiate - règlement 100% sécurisé</p>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow-lg mb-4 mx-5">
      <div class="card-header border-bottom-0 pt-4">
        <div class="d-flex justify-content-center">
          <h4 class="h2 fw-bold">{{ 'Coordonnées de facturation'|trans }}</h4>
        </div>
      </div>
      <div class="card-body mx-auto">
        {% for label, messages in app.flashes %}
          {% for message in messages %}
              <div class="alert alert-{{ label }}" role="alert">
                  {{ message|nl2br }}
              </div>
          {% endfor %}
        {% endfor %}
        {{ form_start(form) }}

          <div class="row">
              <div class="col-12">
                  {{ form_row(form.billingName) }}
              </div>

              <div class="col-12">
                  {{ form_row(form.billingAddress) }}
              </div>

              <div class="col-6">
                  {{ form_row(form.billingPostcode) }}
              </div>

              <div class="col-6">
                  {{ form_row(form.billingCity) }}
              </div>

              {% if form.referralCode is defined %}
                <div
                    class="col-12 mb-3"
                    data-controller="referral"
                    data-referral-url-value="{{ path('app_validate_referral_code') }}"
                >
                    <label class="form-label">
                        {{ form.referralCode.vars.label }}
                    </label>

                    <div class="position-relative">
                        {{ form_widget(form.referralCode, {
                            attr: {
                                class: 'form-control form-control-lg pe-5',
                                'data-referral-target': 'input',
                                'data-action': 'input->referral#reset'
                            }
                        }) }}

                        <button
                            type="button"
                            class="btn btn-success position-absolute top-50 end-0 translate-middle-y me-2"
                            data-action="referral#validate"
                            data-referral-target="button"
                        >
                            <i class="fa-solid fa-check me-1"></i>
                            Valider
                        </button>
                    </div>

                    {{ form_errors(form.referralCode) }}

                    <div
                        class="form-text"
                        data-referral-target="message"
                    >
                        Le code de parrainage vous permet, ainsi qu'à votre parrain,
                        de bénéficier de 45 jours supplémentaires.
                    </div>
                </div>
            {% endif %}

              <div class="col-12 text-end">
                  {{ form_row(form.submit) }}
              </div>
          </div>
        {{ form_end(form) }}
      </div>
    </div>    
  </div>
</div>
{% endblock main %}
