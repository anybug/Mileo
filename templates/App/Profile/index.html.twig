{% extends 'App/advanced_layout.html.twig' %}

{% block content_title %}
    {{ 'Mon profil Mileo'|trans }}
{% endblock %}

{% block main %}

{% set renewUrl = ea_url()
    .setAction('subscriptionForm')
%}

{% set deleteUrl = ea_url()
    .setController('App\\Controller\\App\\UserAppCrudController')
    .setAction('deleteMe')
    .setEntityId(app.user.id)
%}

    <div class="dashboard-content row m-1">
        <div class="mt-3 pb-3 col-12 border-bottom border-light">

            {% if not app.user.hasValidSubscription %}
                <div class="row">
                    <div class="alert alert-info mb-4 pt-4 col-12" role="alert">
                        <p>
                            {{ "Votre abonnement Pro a expiré. Si vous souhaitez continuer à utiliser les fonctionnalités avancées de Mileo, vous pouvez vous abonner"|trans }}
                            <a href="{{ renewUrl }}">{{ "en cliquant ici"|trans }}</a>
                            {{ "ou sur le bouton ci-dessous"|trans }}.
                        </p>
                    </div>
                </div>    
            
            {% elseif app.user.hasExpiringSubscription %}
                <div class="row">
                    <div class="alert alert-warning mb-4 pt-4" role="alert">
                        <p>
                            {{ "Votre abonnement Pro va bientôt expirer. Si vous souhaitez continuer à utiliser les fonctionnalités avancées de Mileo, merci de le renouveler"|trans }}
                            <a href="{{ renewUrl }}">{{ "en cliquant ici"|trans }}</a>
                            {{ "ou sur le bouton ci-dessous"|trans }}.
                        </p>
                    </div>
                </div>    
            {% endif %}

            <div class="card-group">

                <div class="col-lg-6">
                    <div class="card border-secondary text-dark mb-3 me-5">
                        <div class="card-header d-flex justify-content-between bg-light">
                            <h5 class="mt-1"><i class="fa-fw fa fa-id-card"></i> Information du compte</h5>
                            {% set editUrl = ea_url()
                                .setController('App\\Controller\\App\\UserAppCrudController')
                                .setAction('edit') 
                                .setEntityId(app.user.id)%}
                            <div class="fs-5"><a href="{{ editUrl }}" class="btn btn-primary"><i class="fa-solid fa-pen-to-square"></i> {{ "Mettre à jour"|trans }}</a></div>
                        </div>
                        <div class="card-body bg-light">
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'Prénom'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">{{ app.user.firstname}}</p>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'Nom'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">{{ app.user.lastname}}</p>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'E-mail'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">{{ app.user.email}}</p>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'Balance start period'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">
                                        {% if app.user.balanceStartPeriod %}
                                            {{ app.user.balanceStartPeriod|trans}}
                                        {% else %}
                                            <i>{{ 'non renseigné'|trans }}</i>
                                        {% endif %}    
                                    </p>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'Company'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">
                                        {% if app.user.company %}
                                            {{ app.user.company}}
                                        {% else %}
                                            <i>{{ 'non renseigné'|trans }}</i>
                                        {% endif %}    
                                    </p>
                                </div>
                            </div>
                            <hr>
                            
                            {# if app.user.getGoogleId() %}
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ "Compte Google"|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0"><a class="btn btn-lg btn-outline-primary btn-block text-uppercase form-control" href="{{ path('connect_google') }}"><img src="https://img.icons8.com/color/16/000000/google-logo.png">&nbsp;&nbsp;&nbsp;{{ "Connect with Google"|trans }}</a></p>
                                </div>
                                {% for label, messages in app.session.flashBag(['success', 'warning']) %}
                                    {% for message in messages %}
                                        <div class="flash-{{ label }}">
                                            {{ message }}
                                        </div>
                                    {% endfor %}
                                {% endfor %}
                            </div>
                            {% endif #}
                        </div>
                    </div>
                </div>


                <div class="col-lg-6">
                    <div class="card border-secondary text-dark mb-3 me-5">
                        <div class="card-header d-flex justify-content-between bg-light">
                            <h5 class="mt-1"><i class="fa-fw fa-solid fa-file-invoice"></i> {{ 'Subscription'|trans }}</h5>
                            {% set renewUrl = ea_url()
                                .setAction('subscriptionForm')
                            %}
                            <div class="fs-5">
                                <a href="{{ renewUrl }}" class="btn btn-success">
                                    {% if not app.user.hasValidSubscription %}
                                        <i class="fa-solid fa-road"></i> {{ 'Version Pro'|trans }}
                                    {% else %} 
                                        {% if app.user.subscription.plan.code.value == 'free' %}
                                            <i class="fa-solid fa-road"></i> {{ 'Conserver la version Pro'|trans }}
                                        {% else %}     
                                            <i class="fa-solid fa-arrows-rotate"></i> {{ 'Renouveler'|trans }}
                                        {% endif %}
                                    {% endif %}                     
                                </a>
                            </div>
                        </div>
                        <div class="card-body bg-light">
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">
                                        {% if not app.user.hasValidSubscription %}
                                            {{ "PERSO"|trans }}
                                        {% else %} 
                                            {{ "PRO"|trans }}
                                        {% endif %}   
                                    </p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">
                                        {% set price = app.user.getSubscription().getPlan().getPricePerYear() %}
                                        {% if price > 0 %}
                                            {{ app.user.getSubscription().getPlan().getPricePerYear() }}€ {{ 'HT/an'|trans }}
                                        {% else %}
                                            {{ 'Gratuit'|trans }}
                                        {% endif %}    
                                    </p>
                                </div>
                            </div>
                            <hr />

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ 'Depuis le'|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">{{app.user.getSubscription().getSubscriptionStart()|format_datetime(locale='fr',pattern="dd MMMM YYYY")}}</p>
                                </div>
                            </div>
                            <hr />

                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">{{ "Jusqu'au"|trans }}</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">
                                        {% if not app.user.hasValidSubscription %}
                                            <i class="fa-solid fa-infinity"></i>
                                        {% else %} 
                                            {{app.user.getSubscription().getSubscriptionEnd()|format_datetime(locale='fr',pattern="dd MMMM YYYY")}}
                                        {% endif %}  
                                        
                                    </p>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-sm-3">
                                    <p>Jours restants </p>
                                </div>    
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">
                                        {% if not app.user.hasValidSubscription %}
                                            <i class="fa-solid fa-infinity"></i>
                                        {% else %} 
                                            {{ app.user.subscription.daysUntilExpiry }}
                                        {% endif %}  
                                    </p>
                                </div>
                                <div class="px-3">
                                    <div class="progress rounded p-0" style="height: 5px;">
                                        <div class="progress-bar" role="progressbar" style="width: {{app.user.getSubscription().getProgressValue()}}%" aria-valuenow="{{app.user.getSubscription().getProgressValue()}}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div> 
                            <hr>

                        </div>
                    </div>
                </div>  
                <div class="col-lg-6">
                    <div class="card border-secondary text-dark mb-3 me-5">
                        <div class="card-header d-flex justify-content-between bg-light">
                            <h5 class="mt-1">
                                <i class="fa-fw fa-solid fa-calendar-days"></i>
                                {{ 'Calendrier'|trans }}
                            </h5>

                            {% set disableCalendarUrl = ea_url()
                                .setController('App\\Controller\\App\\CalendarUserCrudController')
                                .setAction('disableCalendar')
                                .setEntityId(app.user.id)
                            %}

                            {# --- Bouton suppression compte (index uniquement, dans ce template) --- #}
                            {% include 'App/Profile/_delete_calendar.html.twig' with {
                                disableCalendarUrl: disableCalendarUrl,
                                calendarUserId: app.user.id,
                                reloadAfterDisable: true
                            } %}

                            <div class="d-flex align-items-center gap-3">
                                <button type="button"
                                        class="btn btn-primary"
                                        data-open-calendar-sidepanel
                                        data-sidepanel-id="calendar-sidepanel-profile-calendar"
                                        data-backdrop-id="calendar-sidepanel-backdrop-profile-calendar">
                                    <i class="fa-solid fa-link"></i>
                                    {% if app.user.calendarSynchronized %}
                                        {{ 'Modifier la connexion'|trans }}
                                    {% else %}
                                        {{ 'Connecter mon calendrier'|trans }}
                                    {% endif %}
                                </button>

                                {% if app.user.calendarUrl %}
                                    <button type="button"
                                            class="btn btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#disable-calendar-modal">
                                        <i class="fa-solid fa-link-slash"></i>
                                        {{ 'Déconnecter'|trans }}
                                    </button>
                                {% endif %}
                            </div>
                        </div>

                        <div class="card-body bg-light">

                            <p class="card-text">
                                {{ "Connecter un calendrier permet à l'assistant intelligent (version Pro) d'importer automatiquement vos rendez-vous pour lesquels l'adresse a été renseignée. "|trans }}
                                <br />
                                {{ "Formats supportés: ics, iCal, calDav (Nextcloud, Google, Apple, Microsoft, etc)"|trans }}
                            </p>

                            {% if not app.user.calendarUrl %}
                                <div class="row">
                                    <div class="col-12 text-center py-3">
                                        <p class="text-muted mb-0">
                                            <i>{{ 'Pas de calendrier connecté pour le moment.'|trans }}</i>
                                        </p>
                                    </div>
                                </div>
                            {% else %}

                                <div class="row">
                                    <div class="col-sm-4">
                                        <p class="mb-0">{{ 'Statut'|trans }}</p>
                                    </div>
                                    <div class="col-sm-8">
                                        <p class="mb-0">
                                            {% if app.user.calendarSynchronized %}
                                                <span class="badge bg-success text-white">
                                                    <i class="fa-solid fa-check"></i>
                                                    {{ 'Connecté'|trans }}
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary text-white">
                                                    <i class="fa-solid fa-xmark"></i>
                                                    {{ 'Non synchronisé'|trans }}
                                                </span>
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                <hr>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <p class="mb-0">{{ 'URL calendrier'|trans }}</p>
                                    </div>
                                    <div class="col-sm-8">
                                        <p class="text-muted mb-0 text-break">
                                            {% if app.user.calendarUrl %}
                                                {{ app.user.calendarUrl }}
                                            {% else %}
                                                <i>{{ 'Non renseigné'|trans }}</i>
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                
                                {% if app.user.calendarUsername and app.user.calendarEncryptedPassword %}
                                    <hr>

                                    <div class="row">
                                        <div class="col-sm-4">
                                            <p class="mb-0">{{ 'Identifiants renseignés'|trans }}</p>
                                        </div>
                                        <div class="col-sm-8">
                                            <p class="text-muted mb-0">
                                                <i class="fa-solid fa-check text-success fs-4"></i>
                                            </p>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div> 
            </div>

            {% set hasSavedCalendar = app.user.calendarUrl is not empty %}

            {% form_theme calendarForm '@EasyAdmin/crud/form_theme.html.twig' %}

            {% include 'App/Form/_calendar_connection_sidepanel.html.twig' with {
                form: calendarForm,
                uid: 'profile-calendar',
                showCard: false,
                useFormTag: true,
                hasSavedCalendar: hasSavedCalendar,
                calendarValidationUrl: calendarValidationUrl,
                calendar_validation_url: calendarValidationUrl,
                reloadAfterSave: true,
                titleConnected: 'Calendrier connecté',
                titleDisconnected: 'Connexion au calendrier',
                textConnected: 'Le calendrier est configuré et prêt pour l’importation de trajets.',
                textDisconnected: 'Renseigner l’adresse (URL) du calendrier puis valider.',
                buttonConnected: 'Modifier le calendrier',
                buttonDisconnected: 'Connecter le calendrier'
            } %}

        </div>
    </div>
{% endblock %}
