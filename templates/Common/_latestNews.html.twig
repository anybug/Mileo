{%  if latestNews is defined and latestNews|length>0 %}
    <div class="row mb-4">
        <h3 class="text-primary mb-3">{{ 'Actualités'|trans }}</h3>
        {% for news in latestNews %}
            <div class="col-lg-4 col-md-6 mb-3 pb-2">
                <div class="blog-post rounded border card h-100 shadow-sm">
                    <img src="{{ vich_uploader_asset(news, 'posterFile') }}" class="w-25 mx-auto d-block" alt="{{ news.title }}">                        
                    <div class="card-body">
                        <h5 class="card-title"><i class="fa-solid fa-newspaper me-2"></i> {{ news.title }}</h5>
                        <p class="card-text">{{ news.content|raw }}</p>
                    </div>
                </div>
            </div>    
        {% endfor %}
    </div>
{%  endif  %}