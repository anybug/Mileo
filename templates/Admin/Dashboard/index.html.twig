{% extends 'Team/advanced_layout.html.twig' %}

{% block page_title %}
{% apply spaceless %}
{{ dashboard.title|default('Welcome')|trans }}
{% endapply %}
{% endblock %}

{% block main %} 
    <div class="dashboard-content row m-1"> 
        <div class="mt-3 pb-3 col-12"> 
            <h3 class="text-primary mb-4"> 
                <i class="fa-solid fa-chart-line me-2"></i>
                {{ 'Suivi des abonnements'|trans }}
            </h3>


            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-5 g-3 mb-4">

                <div class="col">
                    <div class="card h-100 border-success shadow-sm">
                        <div class="card-body py-3 px-3 d-flex flex-column">
                            <span class="text-muted small">
                                {{ 'Abonnements actifs'|trans }}
                            </span>

                            <strong class="d-block fs-4 text-success mb-3">
                                {{ subscriptionMetrics.active }}
                            </strong>

                            <a
                                href="{{ subscriptionMetrics.activeUrl }}"
                                class="btn btn-success w-100 mt-auto"
                            >
                                <i class="fa-solid fa-list me-1"></i>
                                {{ 'Voir la liste des actifs'|trans }}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-primary shadow-sm">
                        <div class="card-body py-3 px-3 d-flex flex-column">
                            <span class="text-muted small">
                                {{ 'Échéance sous 30 jours'|trans }}
                            </span>

                            <strong class="d-block fs-4 text-primary mb-3">
                                {{ subscriptionMetrics.expiringWithin30Days }}
                            </strong>

                            <a
                                href="{{ subscriptionMetrics.expiringWithin30DaysUrl }}"
                                class="btn btn-secondary w-100 mt-auto"
                            >
                                <i class="fa-solid fa-list me-1"></i>
                                {{ 'Voir la liste sous 30 jours'|trans }}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-warning shadow-sm">
                        <div class="card-body py-3 px-3 d-flex flex-column">
                            <span class="text-muted small">
                                {{ 'Échéance sous 7 jours'|trans }}
                            </span>

                            <strong class="d-block fs-4 text-warning-emphasis mb-3">
                                {{ subscriptionMetrics.expiringWithin7Days }}
                            </strong>

                            <a
                                href="{{ subscriptionMetrics.expiringWithin7DaysUrl }}"
                                class="btn btn-warning w-100 mt-auto"
                            >
                                <i class="fa-solid fa-list me-1"></i>
                                {{ 'Voir la liste sous 7 jours'|trans }}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-warning shadow-sm">
                        <div class="card-body py-3 px-3 d-flex flex-column">
                            <span class="text-muted small">
                                {{ "Expire aujourd’hui"|trans }}
                            </span>

                            <strong class="d-block fs-4 text-warning-emphasis mb-3">
                                {{ subscriptionMetrics.expiresToday }}
                            </strong>

                            <a
                                href="{{ subscriptionMetrics.expiresTodayUrl }}"
                                class="btn btn-warning w-100 mt-auto"
                            >
                                <i class="fa-solid fa-list me-1"></i>
                                {{ 'Voir la liste du jour'|trans }}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-danger shadow-sm">
                        <div class="card-body py-3 px-3 d-flex flex-column">
                            <span class="text-muted small">
                                {{ 'Expirés'|trans }}
                            </span>

                            <strong class="d-block fs-4 text-danger mb-3">
                                {{ subscriptionMetrics.expired }}
                            </strong>

                            <a
                                href="{{ subscriptionMetrics.expiredUrl }}"
                                class="btn btn-danger w-100 mt-auto"
                            >
                                <i class="fa-solid fa-list me-1"></i>
                                {{ 'Voir la liste des expirés'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ parent() }}


{% endblock %}
