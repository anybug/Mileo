{% extends 'Team/advanced_layout.html.twig' %}

{% block page_title %}
    {% apply spaceless %}
        {{ dashboard.title|default('Dashboard')|trans }}
    {% endapply %}
{% endblock %}

{% block main %}

    {{ parent() }}

    <div class="dashboard-content row m-1">
        <div class="mt-3 pb-3 col-12 border-bottom border-light">

            <h3 class="text-primary mb-4">
                Dashboard administrateur
            </h3>

            <div class="row g-4">

                {# Abonnements bientôt expirés #}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <h4 class="mb-0 text-warning">
                                Abonnements bientôt expirés
                            </h4>
                            <small class="text-muted">
                                Abonnements à surveiller selon leur date d'expiration
                            </small>
                        </div>

                        <div class="card-body">

                            {% set warningTotal =
                                warningSubscriptionsByPhase.sevenDays|length
                                + warningSubscriptionsByPhase.fifteenDays|length
                                + warningSubscriptionsByPhase.thirtyDays|length
                            %}

                            {% if warningTotal > 0 %}

                                <div class="row g-3">

                                    {# Phase 7 jours #}
                                    <div class="col-12 col-xl-4">
                                        <div class="border rounded h-100">
                                            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h5 class="mb-0 text-danger">
                                                        Urgent
                                                    </h5>
                                                    <small class="text-muted">
                                                        Expire dans 7 jours ou moins
                                                    </small>
                                                </div>

                                                <span class="badge bg-danger">
                                                    {{ warningSubscriptionsByPhase.sevenDays.totalItems }}
                                                </span>
                                            </div>

                                            {% if warningSubscriptionsByPhase.sevenDays.items|length > 0 %}
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Utilisateur</th>
                                                                <th>Plan</th>
                                                                <th class="text-end">Fin</th>
                                                                <th class="text-end">Jours</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            {% for subscription in warningSubscriptionsByPhase.sevenDays.items %}
                                                                <tr>
                                                                    <td>
                                                                        {% if subscription.user %}
                                                                            {% set userLabel = (
                                                                                (subscription.user.firstname|default('')) ~ ' ' ~
                                                                                (subscription.user.lastname|default(''))
                                                                            )|trim %}

                                                                            {{ userLabel }} 
                                                                        {% endif %}                                                                   
                                                                    </td>
                                                                    <td>{{ subscription.plan.name }}</td>
                                                                    <td class="text-end fw-bold text-danger">
                                                                        {{ subscription.subscriptionEnd|date('d/m/Y') }}
                                                                    </td>
                                                                    <td class="text-end">
                                                                        {{ subscription.numberDays }}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>

                                                {% if warningSubscriptionsByPhase.sevenDays.totalPages > 1 %}
                                                    <div class="p-2 border-top">
                                                        <nav aria-label="Pagination abonnements 7 jours">
                                                            <ul class="pagination pagination-sm justify-content-end mb-0">
                                                                <li class="page-item {% if warningSubscriptionsByPhase.sevenDays.currentPage <= 1 %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage - 1)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                    }}">
                                                                        Précédent
                                                                    </a>
                                                                </li>

                                                                {% for page in 1..warningSubscriptionsByPhase.sevenDays.totalPages %}
                                                                    <li class="page-item {% if page == warningSubscriptionsByPhase.sevenDays.currentPage %}active{% endif %}">
                                                                        <a class="page-link"
                                                                        href="{{ ea_url()
                                                                            .set('sevenDaysPage', page)
                                                                            .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                            .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                        }}">
                                                                            {{ page }}
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}

                                                                <li class="page-item {% if warningSubscriptionsByPhase.sevenDays.currentPage >= warningSubscriptionsByPhase.sevenDays.totalPages %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage + 1)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                    }}">
                                                                        Suivant
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                    </div>
                                                {% endif %}
                                            {% else %}
                                                <div class="p-3 text-muted">
                                                    Aucun abonnement urgent.
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# Phase 15 jours #}
                                    <div class="col-12 col-xl-4">
                                        <div class="border rounded h-100">
                                            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h5 class="mb-0 text-warning">
                                                        Attention
                                                    </h5>
                                                    <small class="text-muted">
                                                        Expire dans 15 jours ou moins
                                                    </small>
                                                </div>

                                                <span class="badge bg-warning text-dark">
                                                    {{ warningSubscriptionsByPhase.fifteenDays.totalItems }}
                                                </span>
                                            </div>

                                            {% if warningSubscriptionsByPhase.fifteenDays.items|length > 0 %}
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Utilisateur</th>
                                                                <th>Plan</th>
                                                                <th class="text-end">Fin</th>
                                                                <th class="text-end">Jours</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            {% for subscription in warningSubscriptionsByPhase.fifteenDays.items %}
                                                                <tr>
                                                                    <td>
                                                                        {% if subscription.user %}
                                                                            {% set userLabel = (
                                                                                (subscription.user.firstname|default('')) ~ ' ' ~
                                                                                (subscription.user.lastname|default(''))
                                                                            )|trim %}

                                                                            {% if userLabel %}
                                                                                {{ userLabel }}
                                                                                {% if subscription.user.email is defined and subscription.user.email %}
                                                                                    <br>
                                                                                    <small class="text-muted">{{ subscription.user.email }}</small>
                                                                                {% endif %}
                                                                            {% elseif subscription.user.email is defined and subscription.user.email %}
                                                                                {{ subscription.user.email }}
                                                                            {% else %}
                                                                                <span class="text-muted">Utilisateur #{{ subscription.user.id }}</span>
                                                                            {% endif %}
                                                                        {% else %}
                                                                            <span class="text-danger">Aucun utilisateur</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ subscription.plan.name }}</td>
                                                                    <td class="text-end fw-bold text-warning">
                                                                        {{ subscription.subscriptionEnd|date('d/m/Y') }}
                                                                    </td>
                                                                    <td class="text-end">
                                                                        {{ subscription.numberDays }}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>

                                                {% if warningSubscriptionsByPhase.fifteenDays.totalPages > 1 %}
                                                    <div class="p-2 border-top">
                                                        <nav aria-label="Pagination abonnements 15 jours">
                                                            <ul class="pagination pagination-sm justify-content-end mb-0">
                                                                <li class="page-item {% if warningSubscriptionsByPhase.fifteenDays.currentPage <= 1 %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage - 1)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                    }}">
                                                                        Précédent
                                                                    </a>
                                                                </li>

                                                                {% for page in 1..warningSubscriptionsByPhase.fifteenDays.totalPages %}
                                                                    <li class="page-item {% if page == warningSubscriptionsByPhase.fifteenDays.currentPage %}active{% endif %}">
                                                                        <a class="page-link"
                                                                        href="{{ ea_url()
                                                                            .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                            .set('fifteenDaysPage', page)
                                                                            .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                        }}">
                                                                            {{ page }}
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}

                                                                <li class="page-item {% if warningSubscriptionsByPhase.fifteenDays.currentPage >= warningSubscriptionsByPhase.fifteenDays.totalPages %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage + 1)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage)
                                                                    }}">
                                                                        Suivant
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                    </div>
                                                {% endif %}
                                            {% else %}
                                                <div class="p-3 text-muted">
                                                    Aucun abonnement à 15 jours.
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# Phase 30 jours #}
                                    <div class="col-12 col-xl-4">
                                        <div class="border rounded h-100">
                                            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h5 class="mb-0 text-primary">
                                                        À surveiller
                                                    </h5>
                                                    <small class="text-muted">
                                                        Expire dans 30 jours ou moins
                                                    </small>
                                                </div>

                                                <span class="badge bg-primary">
                                                    {{ warningSubscriptionsByPhase.thirtyDays.totalItems }}
                                                </span>
                                            </div>

                                            {% if warningSubscriptionsByPhase.thirtyDays.items|length > 0 %}
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Utilisateur</th>
                                                                <th>Plan</th>
                                                                <th class="text-end">Fin</th>
                                                                <th class="text-end">Jours</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            {% for subscription in warningSubscriptionsByPhase.thirtyDays.items %}
                                                                <tr>
                                                                    <td>
                                                                        {% if subscription.user %}
                                                                            {% set userLabel = (
                                                                                (subscription.user.firstname|default('')) ~ ' ' ~
                                                                                (subscription.user.lastname|default(''))
                                                                            )|trim %}

                                                                            {% if userLabel %}
                                                                                {{ userLabel }}
                                                                                {% if subscription.user.email is defined and subscription.user.email %}
                                                                                    <br>
                                                                                    <small class="text-muted">{{ subscription.user.email }}</small>
                                                                                {% endif %}
                                                                            {% elseif subscription.user.email is defined and subscription.user.email %}
                                                                                {{ subscription.user.email }}
                                                                            {% else %}
                                                                                <span class="text-muted">Utilisateur #{{ subscription.user.id }}</span>
                                                                            {% endif %}
                                                                        {% else %}
                                                                            <span class="text-danger">Aucun utilisateur</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ subscription.plan.name }}</td>
                                                                    <td class="text-end fw-bold text-primary">
                                                                        {{ subscription.subscriptionEnd|date('d/m/Y') }}
                                                                    </td>
                                                                    <td class="text-end">
                                                                        {{ subscription.numberDays }}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>

                                                {% if warningSubscriptionsByPhase.thirtyDays.totalPages > 1 %}
                                                    <div class="p-2 border-top">
                                                        <nav aria-label="Pagination abonnements 30 jours">
                                                            <ul class="pagination pagination-sm justify-content-end mb-0">
                                                                <li class="page-item {% if warningSubscriptionsByPhase.thirtyDays.currentPage <= 1 %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage - 1)
                                                                    }}">
                                                                        Précédent
                                                                    </a>
                                                                </li>

                                                                {% for page in 1..warningSubscriptionsByPhase.thirtyDays.totalPages %}
                                                                    <li class="page-item {% if page == warningSubscriptionsByPhase.thirtyDays.currentPage %}active{% endif %}">
                                                                        <a class="page-link"
                                                                        href="{{ ea_url()
                                                                            .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                            .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                            .set('thirtyDaysPage', page)
                                                                        }}">
                                                                            {{ page }}
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}

                                                                <li class="page-item {% if warningSubscriptionsByPhase.thirtyDays.currentPage >= warningSubscriptionsByPhase.thirtyDays.totalPages %}disabled{% endif %}">
                                                                    <a class="page-link"
                                                                    href="{{ ea_url()
                                                                        .set('sevenDaysPage', warningSubscriptionsByPhase.sevenDays.currentPage)
                                                                        .set('fifteenDaysPage', warningSubscriptionsByPhase.fifteenDays.currentPage)
                                                                        .set('thirtyDaysPage', warningSubscriptionsByPhase.thirtyDays.currentPage + 1)
                                                                    }}">
                                                                        Suivant
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                    </div>
                                                {% endif %}
                                            {% else %}
                                                <div class="p-3 text-muted">
                                                    Aucun abonnement à 30 jours.
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>

                                </div>

                            {% else %}
                                <div class="text-muted">
                                    Aucun abonnement bientôt expiré.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Abonnements actifs #}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-0 text-success">
                                    Abonnements actifs
                                </h4>
                                <small class="text-muted">
                                    Abonnements encore valides
                                </small>
                            </div>

                            <span class="badge bg-success">
                                {{ activeSubscriptions|length }}
                            </span>
                        </div>

                        <div class="card-body p-0">
                            {% if activeSubscriptions|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Utilisateur</th>
                                                <th>Plan</th>
                                                <th class="text-end">Début</th>
                                                <th class="text-end">Fin</th>
                                                <th class="text-end">Jours restants</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {% for subscription in activeSubscriptions %}
                                                <tr>
                                                    <td>
                                                        {% if subscription.user %}
                                                            {% set userLabel = (
                                                                (subscription.user.firstname|default('')) ~ ' ' ~
                                                                (subscription.user.lastname|default(''))
                                                            )|trim %}

                                                            {% if userLabel %}
                                                                {{ userLabel }}
                                                                {% if subscription.user.email is defined and subscription.user.email %}
                                                                    <br>
                                                                    <small class="text-muted">{{ subscription.user.email }}</small>
                                                                {% endif %}
                                                            {% elseif subscription.user.email is defined and subscription.user.email %}
                                                                {{ subscription.user.email }}
                                                            {% else %}
                                                                <span class="text-muted">Utilisateur #{{ subscription.user.id }}</span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="text-danger">Aucun utilisateur</span>
                                                        {% endif %}
                                                    </td>

                                                    <td>
                                                        {{ subscription.plan.name }}
                                                    </td>

                                                    <td class="text-end">
                                                        {{ subscription.subscriptionStart|date('d/m/Y') }}
                                                    </td>

                                                    <td class="text-end">
                                                        {{ subscription.subscriptionEnd|date('d/m/Y') }}
                                                    </td>

                                                    <td class="text-end fw-bold text-success">
                                                        {{ subscription.numberDays }} jour{{ subscription.numberDays > 1 ? 's' : '' }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="p-3 text-muted">
                                    Aucun abonnement actif.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Abonnements expirés #}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-0 text-danger">
                                    Abonnements expirés
                                </h4>
                                <small class="text-muted">
                                    Abonnements arrivés à expiration
                                </small>
                            </div>

                            <span class="badge bg-danger">
                                {{ expiredSubscriptions|length }}
                            </span>
                        </div>

                        <div class="card-body p-0">
                            {% if expiredSubscriptions|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Utilisateur</th>
                                                <th>Plan</th>
                                                <th class="text-end">Début</th>
                                                <th class="text-end">Fin</th>
                                                <th class="text-end">Expiration</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {% for subscription in expiredSubscriptions %}
                                                <tr>
                                                    <td>
                                                        {% if subscription.user %}
                                                            {% set userLabel = (
                                                                (subscription.user.firstname|default('')) ~ ' ' ~
                                                                (subscription.user.lastname|default(''))
                                                            )|trim %}

                                                            {% if userLabel %}
                                                                {{ userLabel }}
                                                                {% if subscription.user.email is defined and subscription.user.email %}
                                                                    <br>
                                                                    <small class="text-muted">{{ subscription.user.email }}</small>
                                                                {% endif %}
                                                            {% elseif subscription.user.email is defined and subscription.user.email %}
                                                                {{ subscription.user.email }}
                                                            {% else %}
                                                                <span class="text-muted">Utilisateur #{{ subscription.user.id }}</span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="text-danger">Aucun utilisateur</span>
                                                        {% endif %}
                                                    </td>

                                                    <td>
                                                        {{ subscription.plan.name }}
                                                    </td>

                                                    <td class="text-end">
                                                        {{ subscription.subscriptionStart|date('d/m/Y') }}
                                                    </td>

                                                    <td class="text-end fw-bold text-danger">
                                                        {{ subscription.subscriptionEnd|date('d/m/Y') }}
                                                    </td>

                                                    <td class="text-end">
                                                        Expiré
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="p-3 text-muted">
                                    Aucun abonnement expiré.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

{% endblock %}