    <p>Choisir une offre :</p>
    <p><a href="{{ url }}">Voir les offres</a></p>

    <p>
        L'équipe
        <span style="font-size: 20px; font-weight: bold; color: #6174d1 !important;">
            <font color="#6174d1">Mil</font>
        </span>
        <span style="font-size: 20px; font-weight: bold; color: #242F51 !important;">
            <font color="#242F51">eo</font>
        </span>
    </p>
